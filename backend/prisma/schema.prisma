generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id           String   @id @default(uuid())
  name         String
  date         DateTime
  totalTickets Int
  tickets      Ticket[]
}

model Ticket {
  id         String       @id @default(uuid())
  eventId    String
  event      Event        @relation(fields: [eventId], references: [id])
  status     TicketStatus @default(AVAILABLE)
  reservedAt DateTime?
  userId     String?
}

enum TicketStatus {
  AVAILABLE
  RESERVED
  SOLD
}